        "openAiApi": {
          "id": "B4TZHIczm0tpk2wS",
          "name": "OpenAi Chatyou"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// A API retorna o vetor como array JS.\n// O Postgres espera o literal de vetor: '[0.1,0.2,...]'\nconst vetor = $json.data?.[0]?.embedding;\n\nif (!Array.isArray(vetor) || vetor.length !== 1536) {\n  throw new Error(`Embedding invalido: esperado array de 1536, recebido ${vetor?.length ?? typeof vetor}`);\n}\n\nreturn [{\n  json: {\n    tenant_id: $('Quando executado por outro workflow').first().json.tenant_id,\n    embedding_literal: '[' + vetor.join(',') + ']'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -144,
        16
      ],
      "id": "c18abaa7-dc51-4544-8ce7-6536b42cb107",
      "name": "Formata Vetor"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT text, similarity\nFROM public.api_n8n_buscar_kb($1::uuid, $2::extensions.vector, 5, '{}'::jsonb)\nORDER BY similarity DESC;",
        "options": {
          "queryReplacement": "={{ [ $json.tenant_id, $json.embedding_literal ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        80,
        16
      ],
      "id": "6aaeb843-e2d3-4ca3-bdb6-91e55f691ec3",
      "name": "Busca Vetorial",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "MehTUROZlPmHG8kW",
          "name": "Agent ia Supabase"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Consolida os trechos num unico texto para o LLM.\n// Retorna string vazia explicita quando nao ha resultado, para o\n// agente saber que precisa transferir em vez de inventar resposta.\nconst itens = $input.all().map(i => i.json).filter(r => r && r.text);\n\nif (itens.length === 0) {\n  return [{ json: { resposta: 'NENHUM_RESULTADO: a base de conhecimento não contém informação sobre esta pergunta.' } }];\n}\n\nconst texto = itens\n  .map((r, i) => `[Trecho ${i + 1} | relevância ${Number(r.similarity).toFixed(3)}]\\n${r.text}`)\n  .join('\\n\\n---\\n\\n');\n\nreturn [{ json: { resposta: texto } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
