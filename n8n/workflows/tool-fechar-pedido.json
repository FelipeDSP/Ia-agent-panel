      "id": "venda-fec-trg00000000000000000000000"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT chatwoot_url, chatwoot_token, tool_ativa, config\nFROM public.api_n8n_config_tool($1::uuid, 'vendas');",
        "options": {
          "queryReplacement": "={{ [ $json.tenant_id ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        608,
        400
      ],
      "name": "Busca Config",
      "id": "venda-cfg000000000000000000000000000",
      "credentials": {
        "postgres": {
          "id": "MehTUROZlPmHG8kW",
          "name": "Agent ia Supabase"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "v1",
              "leftValue": "={{ $json.tool_ativa }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        832,
        400
      ],
      "name": "Vendas Ativa?",
      "id": "venda-if0000000000000000000000000000"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT public.api_n8n_fechar_pedido($1::uuid, $2::bigint, coalesce($3::jsonb, '{}'::jsonb)) AS resultado;",
        "options": {
          "queryReplacement": "={{ [ $('When Executed by Another Workflow').item.json.tenant_id, $('When Executed by Another Workflow').item.json.conversation_id, $('When Executed by Another Workflow').item.json.metadados ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1056,
        320
      ],
      "name": "Fecha Pedido",
      "id": "venda-fec-q0000000000000000000000000",
      "credentials": {
        "postgres": {
          "id": "MehTUROZlPmHG8kW",
          "name": "Agent ia Supabase"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ok-1",
              "name": "resultado",
              "type": "string",
              "value": "={{ $json.resultado }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1280,
        320
      ],
      "name": "Retorno",
      "id": "venda-fec-ok000000000000000000000000"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "off-1",
              "name": "resultado",
              "type": "string",
              "value": "=Nao e possivel montar pedido por aqui. Ofereca ajuda pelos outros meios ou transfira para um atendente."
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
