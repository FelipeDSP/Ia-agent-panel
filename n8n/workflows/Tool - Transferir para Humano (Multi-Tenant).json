    {
      "parameters": {
        "jsCode": "// ============================================================\n// Avalia horario de atendimento a partir da config do tenant.\n// Nada de fuso ou dia da semana hardcoded: tudo vem do banco.\n// ============================================================\n\nconst cfg = $json.config || {};\nconst horario = cfg.horario || {};\nconst notificacao = cfg.notificacao || { canal: 'nenhum' };\n\nconst tz = horario.timezone || 'America/Sao_Paulo';\nconst diasPermitidos = Array.isArray(horario.dias_semana) ? horario.dias_semana : [1,2,3,4,5];\nconst horaInicio = Number.isFinite(horario.hora_inicio) ? horario.hora_inicio : 8;\nconst horaFim = Number.isFinite(horario.hora_fim) ? horario.hora_fim : 18;\n\n// Intl resolve o fuso corretamente, inclusive horario de verao.\n// Calculo manual de offset (como no fluxo antigo) quebra 2x por ano.\nconst agora = new Date();\nconst fmt = new Intl.DateTimeFormat('en-US', {\n  timeZone: tz,\n  weekday: 'short',\n  hour: 'numeric',\n  hour12: false\n});\n\nconst partes = Object.fromEntries(\n  fmt.formatToParts(agora).map(p => [p.type, p.value])\n);\n\nconst mapaDias = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };\nconst diaSemana = mapaDias[partes.weekday];\nconst hora = parseInt(partes.hour, 10);\n\nconst diaOk = diasPermitidos.includes(diaSemana);\nconst horaOk = hora >= horaInicio && hora < horaFim;\nconst disponivel = diaOk && horaOk;\n\nconst entrada = $('When Executed by Another Workflow').first().json;\n\nreturn [{\n  json: {\n    disponivel,\n    tool_ativa: $json.tool_ativa !== false,\n    chatwoot_url: $json.chatwoot_url,\n    chatwoot_token: $json.chatwoot_token,\n    notificacao,\n    tenant_id: entrada.tenant_id,\n    resumo: entrada.resumo,\n    conversation_id: entrada.conversation_id,\n    account_id: entrada.account_id,\n    debug: { tz, diaSemana, hora, diaOk, horaOk }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -592,
        -736
      ],
      "id": "483107b1-7c1d-417a-9ed6-5c76f42309a8",
