# Copie para .env.local e preencha. .env.local nao vai para o git.

# ---------------------------------------------------------------------------
# Painel (Next.js)
# ---------------------------------------------------------------------------

# Publicas: vao para o bundle do browser, e tudo bem — quem protege os dados e
# o RLS, nao o segredo da chave.
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_COLE_AQUI

# Base usada para montar os links de recuperacao de senha.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SECRETA: ignora RLS e enxerga todos os tenants. Servidor apenas.
# Painel do Supabase -> Project Settings -> API Keys -> secret key.
# NUNCA prefixe com NEXT_PUBLIC_ — isso a publicaria no browser.
SUPABASE_SECRET_KEY=sb_secret_COLE_AQUI

# Segredo compartilhado entre o painel e a Edge Function processar-ingestao
# (Fase 4). O painel manda no header x-ingestao-secret; a funcao so aceita quem
# conhece este valor. Gere um aleatorio (ex.: openssl rand -hex 32) e use o
# MESMO aqui e no secret da funcao:
#   supabase secrets set INGESTAO_SECRET=<valor>
# Servidor apenas — nunca prefixe com NEXT_PUBLIC_.
INGESTAO_SECRET=troque_por_um_valor_aleatorio

# Limpeza de memoria do agente (Redis, do lado do n8n). O painel POSTa aqui
# quando o admin manda limpar a memoria de conversas; o n8n confere o segredo no
# header x-limpeza-secret e apaga as chaves de sessao no Redis. URL do webhook do
# workflow n8n; o segredo e o MESMO valor conferido no workflow (LIMPEZA_SECRET).
# Servidor apenas. Se ficarem em branco, o botao retorna erro amigavel.
N8N_LIMPEZA_URL=https://SEU_N8N/webhook/limpar-memoria
N8N_LIMPEZA_SECRET=troque_por_um_valor_aleatorio

# ---------------------------------------------------------------------------
# Edge Function processar-ingestao (Fase 4)
# ---------------------------------------------------------------------------
#
# Estes NAO vao no .env.local do painel — sao secrets da funcao, definidos com
# `supabase secrets set NOME=valor`. Listados aqui so como lembrete:
#   OPENAI_API_KEY   -> chave da OpenAI (embeddings text-embedding-3-small)
#   INGESTAO_SECRET  -> o MESMO valor de INGESTAO_SECRET acima
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY sao injetados automaticamente.

# ---------------------------------------------------------------------------
# Scripts de carga e teste (nao usados pelo painel em execucao)
# ---------------------------------------------------------------------------
#
# Senha com caractere especial precisa de percent-encoding na URL:
#   @ -> %40    # -> %23    / -> %2F    : -> %3A    ? -> %3F
# Senha com @ cru faz o driver ler o host errado, e o erro nao diz isso —
# aparece como host inexistente.

# Postgres de producao no Coolify. Mesmas credenciais que o n8n usa hoje.
# O script de import abre esta conexao como read only.
PROD_DB_URL=postgres://USUARIO:SENHA@SEU_HOST_POSTGRES:5432/postgres

# Supabase via pooler. Painel -> Connect -> Session pooler.
# Use o pooler, nao db.<ref>.supabase.co: o host direto e IPv6-only.
SUPABASE_DB_URL=postgres://postgres.SEU_PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
